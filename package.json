{
  "name": "@valipireddykowshik/mcpdx",
  "version": "0.1.1",
  "description": "Opinionated completeness auditor and runtime linter for Model Context Protocol (MCP) servers. Audits schemas, error boundaries, latency, and observability (Sentry/OTel) with automated AST codemod fixes.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "mcp-tools",
    "mcpdx",
    "mcp-doctor",
    "claude",
    "claude-desktop",
    "cursor",
    "cursor-mcp",
    "anthropic",
    "agentic-ai",
    "llm-tools",
    "linter",
    "doctor",
    "audit",
    "static-analysis",
    "codemod",
    "sentry",
    "opentelemetry",
    "devtools",
    "cli"
  ],
  "author": "kowshik3383",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "mcpdx": "dist/cli.js",
    "mcp-doctor": "dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kowshik3383/mcpdx.git"
  },
  "bugs": {
    "url": "https://github.com/kowshik3383/mcpdx/issues"
  },
  "homepage": "https://github.com/kowshik3383/mcpdx#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.0",
    "commander": "^12.1.0",
    "diff": "^7.0.0",
    "picocolors": "^1.1.1",
    "ts-morph": "^25.0.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "@types/diff": "^7.0.0",
    "@types/node": "^22.13.9",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": ">=0.6.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  }
}
